# GridGuard Environment Variables Template
# Copy this to .env and add your actual values

# API Configuration
API_PORT=8000
APP_ENV=development

# Database (optional)
DATABASE_URL=postgresql://localhost/gridguard

# Redis (optional)
REDIS_URL=redis://localhost:6379

# Alert Settings
ALERT_THRESHOLD=0.85

# BESCOM API (if available)
BESCOM_API_URL=https://bescom-api.example.com
BESCOM_API_KEY=your-api-key-here
